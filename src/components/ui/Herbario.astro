---
interface Props {
  numero: number | string;
  bloque: string;
  duracion: string;
  requisitos?: string;
}

const {
  numero,
  bloque,
  duracion,
  requisitos = 'Ninguno',
} = Astro.props;
---

<div class="herbario-etiqueta" role="region" aria-label="Ficha de la lección">
  <div class="herbario-pin" aria-hidden="true"></div>
  <div class="herbario-grid">
    <div class="herbario-item">
      <span class="herbario-label">Lección</span>
      <span class="herbario-val herbario-num">#{numero}</span>
    </div>
    <div class="herbario-item">
      <span class="herbario-label">Itinerario</span>
      <span class="herbario-val">{bloque}</span>
    </div>
    <div class="herbario-item">
      <span class="herbario-label">Tiempo estimado</span>
      <span class="herbario-val">⏱ {duracion}</span>
    </div>
    <div class="herbario-item">
      <span class="herbario-label">Requisitos previos</span>
      <span class="herbario-val">{requisitos}</span>
    </div>
  </div>
</div>

<style>
  .herbario-etiqueta {
    margin: 1rem 0 2rem 0;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    background-color: var(--superficie);
    border: 1px solid var(--linea);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05), 0 2px 8px rgba(0, 0, 0, 0.04);
    position: relative;
    border-left: 4px solid var(--musgo);
  }

  .herbario-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.85rem;
  }

  .herbario-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .herbario-label {
    font-size: 0.725rem;
    font-family: var(--sl-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-secundaria);
  }

  .herbario-val {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--tinta);
  }

  .herbario-num {
    color: var(--musgo);
    font-family: var(--sl-font-mono);
    font-size: 1.1rem;
  }
</style>
