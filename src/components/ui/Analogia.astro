---
interface Props {
  conceptoBiologico: string;
  titulo?: string;
  limite?: string;
}

const { conceptoBiologico, titulo, limite } = Astro.props;
---

<div class="analogia-card" role="region" aria-label={`Analogía: ${conceptoBiologico}`}>
  <div class="analogia-badge">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
      <path d="M12 2a9 9 0 0 1 9 9c0 4.97-4.03 9-9 9a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9z" />
      <path d="M12 6v12M8 10l4-4 4 4M8 14l4 4 4-4" />
    </svg>
    <span>En el campo · Cuaderno de naturalista</span>
  </div>

  <div class="analogia-header">
    <h3 class="analogia-title">{titulo || conceptoBiologico}</h3>
    <span class="analogia-subtitulo">Analogía con: <em>{conceptoBiologico}</em></span>
  </div>

  <div class="analogia-content">
    <slot />
  </div>

  <div class="analogia-limite">
    <div class="limite-header">
      <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
      </svg>
      <strong>Dónde deja de valer la analogía (límite honesto):</strong>
    </div>
    <div class="limite-body">
      {limite ? <p>{limite}</p> : <slot name="limite" />}
    </div>
  </div>
</div>

<style>
  .analogia-card {
    margin: 2rem 0;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background-color: var(--superficie);
    border: 1px solid var(--musgo-borde);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    position: relative;
  }

  .analogia-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-family: var(--sl-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--musgo);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .analogia-header {
    border-bottom: 1px dashed var(--linea);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
  }

  .analogia-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--tinta);
  }

  .analogia-subtitulo {
    font-size: 0.95rem;
    color: var(--tinta-secundaria);
    display: block;
    margin-top: 0.25rem;
  }

  .analogia-content {
    color: var(--tinta);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .analogia-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .analogia-limite {
    background-color: var(--musgo-suave);
    border: 1px dashed var(--musgo-borde);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-top: 1rem;
  }

  .limite-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--terracota);
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .limite-body {
    font-size: 0.925rem;
    color: var(--tinta);
    line-height: 1.55;
  }

  .limite-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
