---
interface Props {
  fecha: string; // Formato esperado: "AAAA-MM", ej. "2026-10"
  fuente: string;
  nota?: string;
}

const { fecha, fuente, nota } = Astro.props;

// Formatear mes y año en español si sigue el formato AAAA-MM
function formatearFecha(f: string): string {
  const parts = f.split('-');
  if (parts.length === 2) {
    const anio = parts[0];
    const meses = [
      'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
      'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'
    ];
    const mesIndex = parseInt(parts[1], 10) - 1;
    if (mesIndex >= 0 && mesIndex < 12) {
      return `${meses[mesIndex]} de ${anio}`;
    }
  }
  return f;
}

const fechaLegible = formatearFecha(fecha);
---

<span class="verificado-badge" title={nota ? `Dato comprobado: ${nota}` : `Dato comprobado con la documentación oficial en ${fechaLegible}`}>
  <a
    href={fuente}
    target="_blank"
    rel="noopener noreferrer"
    class="verificado-link"
    aria-label={`Dato verificado en ${fechaLegible} según fuente oficial (abre en nueva pestaña)`}
  >
    <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true" class="verificado-icon">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
    </svg>
    <span class="verificado-texto">Verificado · {fechaLegible}</span>
    <svg viewBox="0 0 20 20" fill="currentColor" width="11" height="11" aria-hidden="true" class="external-icon">
      <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
      <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
    </svg>
  </a>
</span>

<style>
  .verificado-badge {
    display: inline-flex;
    vertical-align: middle;
    margin: 0 0.25rem;
  }

  .verificado-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.785rem;
    font-family: var(--sl-font-mono);
    color: var(--musgo);
    background-color: var(--musgo-suave);
    border: 1px solid var(--musgo-borde);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
    line-height: 1.3;
  }

  .verificado-link:hover {
    background-color: var(--musgo);
    color: var(--papel);
    border-color: var(--musgo);
  }

  .verificado-icon {
    flex-shrink: 0;
  }

  .external-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }
</style>

